{
  "name": "omni-auth",
  "version": "7.0.0",
  "description": "OmniAuth — omnichannel authentication utility library with first-class Next.js integration",
  "author": "Omni Auth Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzvka/omni-auth.git"
  },
  "bugs": {
    "url": "https://github.com/suzvka/omni-auth/issues"
  },
  "homepage": "https://github.com/suzvka/omni-auth#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./request": {
      "types": "./dist/request.d.ts",
      "import": "./dist/request.js",
      "require": "./dist/request.cjs"
    },
    "./adapters/pg": {
      "types": "./dist/adapters/pg.d.ts",
      "import": "./dist/adapters/pg.js",
      "require": "./dist/adapters/pg.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "import": "./dist/nextjs/index.js",
      "require": "./dist/nextjs/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./codegen-ddl": {
      "types": "./dist/codegen-ddl.d.ts",
      "import": "./dist/codegen-ddl.js",
      "require": "./dist/codegen-ddl.cjs"
    },
    "./codegen-prisma": {
      "types": "./dist/codegen-prisma.d.ts",
      "import": "./dist/codegen-prisma.js",
      "require": "./dist/codegen-prisma.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "bin": {
    "omni-auth-codegen": "bin/codegen.mjs"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "node bin/codegen.mjs"
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@better-auth/core": "~1.6.26",
    "@better-auth/utils": "~0.4.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "next": "16.2.6",
    "pg": "^8",
    "pg-mem": "^3.0.14",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "omnichannel",
    "channel-parity"
  ]
}
