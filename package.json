{
  "name": "omni-auth-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "omni-auth monorepo — 全渠道认证工具库（packages/omni-auth）+ 演示宿主（apps/demo）",
  "scripts": {
    "build": "pnpm --filter omni-auth build",
    "dev": "pnpm --filter omni-auth-demo dev",
    "build:demo": "pnpm --filter omni-auth-demo build",
    "start": "pnpm --filter omni-auth-demo start",
    "lint": "pnpm --filter omni-auth-demo lint",
    "test": "pnpm --filter omni-auth test",
    "typecheck": "pnpm --filter omni-auth typecheck",
    "publish": "pnpm --filter omni-auth publish --access public"
  }
}
