{
  "name": "omni-user-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:packages": "pnpm -r --filter omni-auth --filter omni-auth-nextjs build",
    "publish:packages": "pnpm -r --filter omni-auth --filter omni-auth-nextjs publish --access public"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "better-auth": "^1.6.26",
    "omni-auth": "workspace:*",
    "omni-auth-nextjs": "workspace:*",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
