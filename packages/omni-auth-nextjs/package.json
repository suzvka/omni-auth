{
  "name": "omni-auth-nextjs",
  "version": "0.6.1",
  "description": "Next.js integration layer for omni-auth SDK",
  "author": "Omni Auth Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/suzvka/omni-auth.git",
    "directory": "packages/omni-auth-nextjs"
  },
  "bugs": {
    "url": "https://github.com/suzvka/omni-auth/issues"
  },
  "homepage": "https://github.com/suzvka/omni-auth#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "omni-auth": "workspace:*",
    "next": ">=16"
  },
  "dependencies": {
    "omni-auth": "workspace:*"
  },
  "devDependencies": {
    "next": "16.2.6",
    "tsup": "^8",
    "typescript": "^5"
  },
  "keywords": [
    "auth",
    "nextjs",
    "authentication"
  ]
}
