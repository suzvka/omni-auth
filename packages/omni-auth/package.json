{
  "name": "omni-auth",
  "version": "0.6.2",
  "description": "OmniAuth — omnichannel authentication SDK, framework-agnostic, built on Better Auth",
  "author": "Omni Auth Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzvka/omni-auth.git",
    "directory": "packages/omni-auth"
  },
  "bugs": {
    "url": "https://github.com/suzvka/omni-auth/issues"
  },
  "homepage": "https://github.com/suzvka/omni-auth#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/pg": {
      "types": "./dist/adapters/pg.d.ts",
      "import": "./dist/adapters/pg.js",
      "require": "./dist/adapters/pg.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "omni-auth": "bin/db-push.mjs"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "better-auth": "^1.6.26"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "better-auth": "^1.6.26"
  },
  "devDependencies": {
    "@types/pg": "^8",
    "pg": "^8",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "better-auth",
    "omnichannel",
    "channel-parity"
  ]
}
